<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy FX | Delivery Platform</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f5f7fb;
      color: #172033;
    }

    header {
      background: #111827;
      color: white;
      padding: 18px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
    }

    .hero {
      background: #111827;
      color: white;
      padding: 70px 6%;
      text-align: center;
    }

    .hero h1 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 18px;
      color: #cbd5e1;
      margin-bottom: 30px;
    }

    .btn {
      border: none;
      padding: 14px 24px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 16px;
      font-weight: bold;
      margin: 5px;
    }

    .primary {
      background: #22c55e;
      color: white;
    }

    .secondary {
      background: white;
      color: #111827;
    }

    .section {
      padding: 45px 6%;
      max-width: 1100px;
      margin: auto;
    }

    .section h2 {
      text-align: center;
      margin-bottom: 30px;
      font-size: 30px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .card {
      background: white;
      padding: 30px;
      border-radius: 14px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      text-align: center;
    }

    .icon {
      font-size: 45px;
      margin-bottom: 15px;
    }

    .card h3 {
      margin-bottom: 10px;
    }

    .card p {
      color: #64748b;
      line-height: 1.5;
    }

    .order-box {
      background: white;
      padding: 30px;
      max-width: 600px;
      margin: auto;
      border-radius: 14px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    input, select {
      width: 100%;
      padding: 14px;
      margin: 8px 0 15px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      font-size: 16px;
    }

    label {
      font-weight: bold;
    }

    footer {
      background: #111827;
      color: white;
      text-align: center;
      padding: 25px;
      margin-top: 30px;
    }

    @media (max-width: 700px) {
      .cards {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        font-size: 32px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="logo">Happy FX</div>
  <button class="btn secondary" onclick="showLogin()">Sign In</button>
</header>

<section class="hero">
  <h1>Delivery Made Simple</h1>
  <p>Shop, order and get your goods delivered to your door.</p>

  <button class="btn primary" onclick="goToOrder()">
    Start Shopping
  </button>

  <button class="btn secondary" onclick="showVendor()">
    Become a Vendor
  </button>
</section>

<section class="section">
  <h2>How Happy FX Works</h2>

  <div class="cards">

    <div class="card">
      <div class="icon">🛍️</div>
      <h3>Customer</h3>
      <p>
        Customers browse products, place orders and choose where
        they want their goods delivered.
      </p>
    </div>

    <div class="card">
      <div class="icon">🏪</div>
      <h3>Vendor</h3>
      <p>
        Vendors list their products, receive orders and prepare
        them for delivery.
      </p>
    </div>

    <div class="card">
      <div class="icon">🛵</div>
      <h3>Rider</h3>
      <p>
        Riders receive delivery jobs, collect orders and deliver
        them to customers.
      </p>
    </div>

  </div>
</section>

<section class="section" id="order">

  <h2>Place an Order</h2>

  <div class="order-box">

    <label>Your Name</label>
    <input id="name" type="text" placeholder="Enter your name">

    <label>What do you want?</label>
    <input id="item" type="text" placeholder="Example: Groceries">

    <label>Delivery Location</label>
    <input id="location" type="text" placeholder="Enter delivery location">

    <label>Payment Method</label>

    <select id="payment">
      <option>M-Pesa</option>
      <option>Cash on Delivery</option>
    </select>

    <button class="btn primary" onclick="placeOrder()">
      Place Order
    </button>

    <p id="message" style="margin-top:15px;"></p>

  </div>

</section>

<footer>
  <p>© 2026 Happy FX. All rights reserved.</p>
  <p style="margin-top:8px;">Customer • Vendor • Rider</p>
</footer>

<script>

function goToOrder() {
  document.getElementById("order").scrollIntoView({
    behavior: "smooth"
  });
}

function placeOrder() {

  const name = document.getElementById("name").value;
  const item = document.getElementById("item").value;
  const location = document.getElementById("location").value;

  const message = document.getElementById("message");

  if (!name || !item || !location) {
    message.style.color = "red";
    message.innerText = "Please fill in all the fields.";
    return;
  }

  message.style.color = "green";
  message.innerText =
    "Order received! Your delivery request has been created.";
}

function showLogin() {
  alert("Customer, Vendor and Rider login will be added next.");
}

function showVendor() {
  alert("Vendor registration will be added next.");
}

</script>

</body>
</html>
